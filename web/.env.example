# ── Verdyn environment ─────────────────────────────────────────────
# Everything here is OPTIONAL — the engine runs fully in-browser without any
# of it. Each variable unlocks a capability.

# Postgres (Neon works great). Unlocks: accounts, saved profiles, the
# unattended executor, restriction cache, and the MCP (agentic) endpoint.
# Apply the schema once: DATABASE_URL=... node web/scripts/migrate.mjs
DATABASE_URL=

# 32+ random chars. Seals session cookies + stored controller tokens
# (AES-256-GCM). Required in production if DATABASE_URL is set.
VERDYN_SESSION_SECRET=

# Bearer token protecting /api/cron/run (the unattended executor). Schedule
# that route every 15 minutes with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Magic-link sign-in emails via Resend. Without it, sign-in links are logged
# to the server console (fine for development / single-user self-hosting).
RESEND_API_KEY=
EMAIL_FROM="Verdyn <hello@example.com>"

# Comma-separated emails granted a permanent owner entitlement on sign-in.
VERDYN_COMP_EMAILS=

# Public origin of this deployment — used to build agent-connector URLs.
NEXT_PUBLIC_BASE_URL=

# Optional AI features (Expert restriction research + sprinkler-head vision).
# Any OpenAI-compatible endpoint/key works; both features degrade gracefully.
MINIMAX_API_KEY=
MINIMAX_MODEL=
